# ── 필수 ──────────────────────────────────────────────────────────────────

# Slack App (Socket Mode). SETUP.md 1단계 참고.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Slack 프로필 > More > Copy member ID. 이 ID만 봇을 트리거할 수 있다 (그 외 메시지는 조용히 무시).
ALLOWED_SLACK_USER_ID=U0XXXXXXX

# 봇이 작업할 대상 repo의 로컬 클론 경로.
REPO_PATH=/home/ubuntu/your-repo

# 대상 repo의 GitHub 슬러그 "owner/name". gh PR 생성 + PR 본문 스크린샷 raw URL에 사용.
GITHUB_REPO=your-org/your-repo

# ── 선택 (기본값이 있음) ──────────────────────────────────────────────────

# claude CLI 경로 (PATH에 있으면 그대로).
CLAUDE_BIN=claude

# claude 실행 시 permission mode. 무인 실행이라 기본은 bypassPermissions.
CLAUDE_PERMISSION_MODE=bypassPermissions

# 대상 repo에 커스텀 슬래시 커맨드가 있으면 지정 (예: /start). 비우면 요청 텍스트를 그대로 전달.
CLAUDE_SLASH_COMMAND=

# 봇이 만드는 브랜치 접두사와 베이스 브랜치.
BRANCH_PREFIX=anvil
BASE_BRANCH=main

# 작업 하나당 최대 대기 시간 (ms). 기본 15분.
TASK_TIMEOUT_MS=900000

# 후속 답변("응", "그렇게 해줘")을 같은 작업으로 이어붙이는 시간 (ms). 기본 30분.
SESSION_TTL_MS=1800000

# ── 디자인 목업 스크린샷 (opt-in, 웹 프론트엔드 repo에서만 의미 있음) ────────

# 켜면: 화면 관련 작업 시 claude가 .anvil-preview.html 정적 목업을 만들고, Playwright로
# 스크린샷을 찍어 계획 단계면 Slack에, 코드 변경 단계면 PR 본문에 첨부한다.
PREVIEW_ENABLED=false

# 스크린샷 뷰포트 "너비x높이". 모바일 UI면 430x932 등.
PREVIEW_VIEWPORT=1280x800

# "UI 파일이 바뀌었다"고 볼 경로 정규식 (스크린샷 강제 생성 트리거).
PREVIEW_UI_PATTERN=\.(tsx?|jsx?|vue|svelte|css|scss|html)$

# claude에게 목업을 만들라고 붙이는 지침 전체를 덮어쓰고 싶을 때. 비우면 기본 지침 사용.
PREVIEW_INSTRUCTION=
